<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Direct distribution outside the Mac App Store -->
    <key>method</key>
    <string>developer-id</string>

    <key>teamID</key>
    <string>59MJ8J2KF3</string>

    <!-- Let Xcode pick the Developer ID Application cert + profile automatically -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!-- Hardened Runtime is already enabled in build settings; keep it on export -->
    <key>destination</key>
    <string>export</string>
</dict>
</plist>
